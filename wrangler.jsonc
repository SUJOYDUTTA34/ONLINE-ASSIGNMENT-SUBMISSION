{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "online-assignment-submission",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "assignment_portal_db",
      "database_id": "a71f76cb-8197-4ff4-afcd-c501b3ee0bfa"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "assignment-files"
    }
  ]
}
