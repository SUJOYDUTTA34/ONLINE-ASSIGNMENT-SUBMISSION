# ==============================================================================
# Environment Variables Configuration Template
# All secrets and API credentials must be populated via environment variables.
# Never commit actual secret keys or credentials to version control.
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
GEMINI_API_KEY=""

# APP_URL: The public base URL where this application is hosted.
APP_URL="http://localhost:3000"

# SMTP Configuration for custom emails (Server-side only)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
